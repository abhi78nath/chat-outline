{
    "manifest_version": 3,
    "name": "AI Chat TOC",
    "version": "1.0.0",
    "description": "ChatGPT Conversation Outline and Monitoring.",
    "icons": {
        "16": "public/icons/icon16.png",
        "32": "public/icons/icon32.png",
        "48": "public/icons/icon48.png",
        "128": "public/icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://chatgpt.com/*"
    ],
    "action": {
        "default_title": "AI Chat TOC"
    },
    "content_scripts": [
        {
            "js": [
                "src/content.tsx"
            ],
            "matches": [
                "https://chatgpt.com/*"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/scripts/inject.js"
            ],
            "matches": [
                "https://chatgpt.com/*"
            ]
        }
    ]
}